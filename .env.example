# This is a configuration reference; server.mjs reads process.env, not this file.
# Use your shell or a process manager to set variables. Never commit actual keys.
PORT=4173
HOST=127.0.0.1
AUREON_DATA_DIR=.aureon-data
AUREON_MONITOR=1
AUREON_POLL_MS=15000
AUREON_REGISTRATION=1
# Required when binding beyond loopback; public HTTPS origin behind your TLS proxy.
# AUREON_ORIGIN=https://your-private-terminal.example
# First register the owner through the localhost UI, stop the server, then enable:
# AUREON_BROKER_USER=your_preexisting_username
# APCA_API_KEY_ID=your_paper_account_key
# APCA_API_SECRET_KEY=your_paper_account_secret
# ALPACA_DATA_FEED=iex

# Optional research: owner must already exist before restart.
AUREON_RESEARCH_USER=
ALPACA_OPTION_FEED=indicative
FRED_API_KEY=
SEC_USER_AGENT=
# SEC_USER_AGENT should identify your application and include operator email.
AUREON_MODERATORS=

# Explicit external-notification configuration; requires later in-app consent.
AUREON_NOTIFICATION_RECIPIENTS={}
AUREON_WEBHOOKS={}
# Recipients JSON: {"existing_username":{"email":"owned-address","sms":"owned-E164"}}
# Webhooks JSON: {"alias":{"username":"existing_username","url":"https://owned.example/hook","secret":"minimum-32-character-signing-secret"}}
RESEND_API_KEY=
AUREON_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AUREON_PUSH_CONTACT=
# AUREON_PUSH_CONTACT=mailto:operator@your-owned-domain

# Separate real-money adapter: remain disabled until independently reviewed.
# No normal ticket/script/alert invokes this route.
AUREON_LIVE_ENABLED=
AUREON_LIVE_USER=
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
AUREON_LIVE_MAX_NOTIONAL=1000
AUREON_LIVE_DAILY_NOTIONAL=5000
# Intentional switch (do not enable with demo settings): I_ACCEPT_REAL_MONEY_RISK
# HTTPS + pre-existing MFA owner + exact per-order confirmation are also required.
