indicator("Incremental trend and volatility", overlay=true)
n=input.int(20, "Length", minval=1, maxval=500)
fast=ta.ema(close,n)
slow=ta.sma(close,n*2)
sigma=ta.stdev(close,n)
plot(fast,"EMA",color=color.aqua)
plot(slow,"SMA",color=color.orange)
plot(fast+2*sigma,"Upper",color=color.gray)
plot(fast-2*sigma,"Lower",color=color.gray)
plotshape(ta.crossover(fast,slow),title="Cross",color=color.green)
alertcondition(ta.crossover(fast,slow),"Trend crossing","Fast EMA crossed above slow SMA")
